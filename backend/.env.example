# Copia questo file in .env e compila i valori.
# Porta locale su cui gira l'app (frontend + API).
PORT=1969

# Credenziali Google OAuth (Google Cloud Console > Credenziali > ID client OAuth 2.0).
# Redirect URI da configurare su Google: http://localhost:1969/auth/google/callback
# Se lasciate vuote, il login è disattivato e si accede direttamente alle Impostazioni
# per poterle configurare la prima volta.
GOOGLE_CLIENT_ID=

# Email autorizzate ad accedere, separate da virgola (whitelist).
ALLOWED_EMAIL=

# Segreto per firmare i cookie di sessione. Genera una stringa casuale lunga.
SESSION_SECRET=cambia-questo-segreto

# Gemini model.
GEMINI_MODEL=gemini-flash-lite-latest