# Copia questo file in .env e compila i valori.
#
# Perché questo file esiste separato da backend/data/config.json:
# config.json contiene dati di dominio (fornitore, clienti, fatturazione...)
# ed è incluso per intero negli export di backup (.tsbk) e letto/scritto a
# runtime da più service. I segreti qui sotto restano in .env perché letti
# solo all'avvio, mai riscritti a runtime, mai serializzati in una response
# API e mai inclusi nel backup: rischio di leak accidentale = 0. Spostarli
# in config.json li esporrebbe a quei canali. Non unificare i due file.

# Porta locale su cui gira l'app (frontend + API).
PORT=1969

# Credenziali Google OAuth (Google Cloud Console > Credenziali > ID client OAuth 2.0).
# Redirect URI da configurare su Google: http://localhost:1969/auth/google/callback
# Se lasciate vuote, il login è disattivato e si accede direttamente alle Impostazioni
# per poterle configurare la prima volta.
GOOGLE_CLIENT_ID=

# Email autorizzate ad accedere, separate da virgola (whitelist).
ALLOWED_EMAIL=

# Segreto per firmare i cookie di sessione. Genera una stringa casuale lunga.
SESSION_SECRET=cambia-questo-segreto

# Gemini model.
GEMINI_MODEL=gemini-flash-lite-latest

# Groq model (fallback usato solo quando la quota Gemini free è esaurita).
GROQ_MODEL=llama-3.3-70b-versatile